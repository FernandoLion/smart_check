rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Perfil de cada usuario (lo crea la app al registrarse).
    // Solo el propio usuario puede leerlo y crearlo; no se puede modificar
    // desde la app, para que nadie cambie su rol después de registrarse.
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.roles is list
        && request.resource.data.roles.size() > 0
        && request.resource.data.roles.hasOnly(['docente', 'estudiante']);
      allow update, delete: if false;
    }
  }
}
