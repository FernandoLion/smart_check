rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function miPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function soyDocente() {
      return autenticado() && 'docente' in miPerfil().get('roles', []);
    }

    // Cédula y correo con los que el docente pudo inscribir al usuario.
    function misClaves() {
      return [
        miPerfil().get('cedula', ''),
        request.auth.token.get('email', '').lower()
      ];
    }

    // Perfil de cada usuario (lo crea la app al registrarse).
    // Solo el propio usuario puede leerlo y crearlo; no se puede modificar
    // desde la app, para que nadie cambie su rol después de registrarse.
    // PENDIENTE: el rol docente lo decide la app según Chairá; quien escriba
    // directo en Firestore podría asignárselo. Cerrarlo con una Cloud Function.
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.roles is list
        && request.resource.data.roles.size() > 0
        && request.resource.data.roles.hasOnly(['docente', 'estudiante']);
      // Lo único que el usuario puede cambiar de su perfil es el celular con
      // el que marca asistencia, y solo eso: el rol sigue siendo intocable.
      // `dispositivo_desde` tiene que ser la hora del servidor, así que la
      // app escribe `FieldValue.serverTimestamp()`; si la pusiera el celular,
      // adelantar el reloj saltaría la espera. Entre cambio y cambio pasan 7
      // días; a quien se le dañe el celular antes, lo marca el docente a mano.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['dispositivo_id', 'dispositivo_desde'])
        && request.resource.data.dispositivo_id is string
        && request.resource.data.dispositivo_id.size() >= 8
        && request.resource.data.dispositivo_desde == request.time
        && (resource.data.get('dispositivo_id', '') == ''
          || resource.data.dispositivo_desde + duration.value(7, 'd')
               <= request.time);
      allow delete: if false;

      // El historial de celulares: se añade, no se corrige ni se borra.
      match /dispositivos/{registro} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.desde == request.time;
        allow update, delete: if false;
      }
    }

    // Cursos: los crea un docente a su nombre; los leen él y sus inscritos.
    match /cursos/{cursoId} {
      function curso() {
        return get(/databases/$(database)/documents/cursos/$(cursoId)).data;
      }

      function soySuDocente() {
        return autenticado() && curso().docente_uid == request.auth.uid;
      }

      function estoyInscrito() {
        return autenticado() && curso().claves_inscritos.hasAny(misClaves());
      }

      allow read: if autenticado()
        && (resource.data.docente_uid == request.auth.uid
          || resource.data.claves_inscritos.hasAny(misClaves()));
      allow create: if soyDocente()
        && request.resource.data.docente_uid == request.auth.uid
        && request.resource.data.claves_inscritos is list;
      allow update: if autenticado()
        && resource.data.docente_uid == request.auth.uid
        && request.resource.data.docente_uid == resource.data.docente_uid;
      allow delete: if autenticado()
        && resource.data.docente_uid == request.auth.uid;

      match /inscritos/{clave} {
        allow read: if soySuDocente() || clave in misClaves();
        allow write: if soySuDocente();
      }

      match /sesiones/{sesionId} {
        function sesion() {
          return get(/databases/$(database)/documents/cursos/$(cursoId)/sesiones/$(sesionId)).data;
        }

        allow read: if soySuDocente() || estoyInscrito();
        // El llamado de asistencia dura 10 minutos como máximo y arranca
        // cuando el docente abre el radar. Se acota contra la hora del
        // servidor para que no se pueda fabricar una ventana más larga ni a
        // otra hora; la holgura es por el reloj del celular y la latencia.
        // `bloque_inicio` es la franja del horario, y es por donde se agrupan
        // los llamados al contar la asistencia.
        allow create: if soySuDocente()
          && request.resource.data.abierta == true
          && request.resource.data.fin > request.resource.data.inicio
          && request.resource.data.fin
            <= request.resource.data.inicio + duration.value(10, 'm')
          && request.resource.data.fin <= request.time + duration.value(13, 'm')
          && request.resource.data.inicio >= request.time - duration.value(10, 'm')
          && request.resource.data.bloque_inicio is timestamp
          && request.resource.data.bloque_inicio <= request.resource.data.inicio;
        // Solo se puede cerrar; no se reabre ni se cambia la franja.
        allow update: if soySuDocente()
          && request.resource.data.abierta == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['abierta']);
        // Solo al eliminar el curso completo (la app no borra sesiones sueltas).
        allow delete: if soySuDocente();

        // Solo el celular del docente escribe asistencias. Por BLE, con la
        // sesión abierta y dentro de su franja (hora del servidor); a mano,
        // también después, para corregir.
        match /asistencias/{clave} {
          allow read: if soySuDocente() || clave in misClaves();
          allow create, update: if soySuDocente()
            && clave in curso().claves_inscritos
            && request.resource.data.registrado_por == request.auth.uid
            && (request.resource.data.metodo == 'manual'
              || (sesion().abierta
                && request.time >= sesion().inicio
                && request.time < sesion().fin
                // La otra llave: sin la firma del estudiante no hay
                // asistencia por BLE. A mano sigue pudiendo el docente, que
                // es la corrección de siempre y queda marcada como tal.
                && exists(/databases/$(database)/documents/cursos/$(cursoId)/sesiones/$(sesionId)/presencias/$(clave))));
          // Solo al eliminar el curso completo.
          allow delete: if soySuDocente();
        }

        // La firma del estudiante: la escribe él, desde el celular que tiene
        // vinculado y dentro de la ventana. Es lo único que el servidor sabe
        // de su lado; la geocerca y la huella las comprueba su celular, y de
        // esas no hay prueba posible sin un backend propio.
        match /presencias/{clave} {
          allow read: if soySuDocente() || clave in misClaves();
          allow create: if autenticado()
            && clave in misClaves()
            && clave in curso().claves_inscritos
            && sesion().abierta
            && request.time >= sesion().inicio
            && request.time < sesion().fin
            && request.resource.data.creado_en == request.time
            && request.resource.data.dispositivo != ''
            && request.resource.data.dispositivo
                 == miPerfil().get('dispositivo_id', '')
            && request.resource.data.vinculado_en
                 == miPerfil().get('dispositivo_desde', request.time);
          // Se firma una vez y no se retoca.
          allow update: if false;
          // Solo al eliminar el curso completo.
          allow delete: if soySuDocente();
        }
      }
    }
  }
}
